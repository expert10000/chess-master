{
  "name": "stockfish-coach",
  "version": "1.15.4",
  "private": true,
  "description": "Stockfish Coach 1.15.4 — Fast play preserves the selected opponent strength with calculation-quality floors.",
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "dev": "concurrently -k -n renderer,electron-ts,electron \"npm:dev:renderer\" \"npm:dev:electron:compile\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:electron:compile": "tsc -p tsconfig.electron.json --watch --preserveWatchOutput",
    "dev:electron": "node scripts/start-electron.mjs",
    "build": "npm run clean && npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "test": "vitest run",
    "stockfish:add": "node scripts/add-stockfish.mjs",
    "stockfish:check": "node scripts/check-stockfish.mjs",
    "ollama:check": "node scripts/check-ollama.mjs",
    "release:static": "node scripts/release-qa.mjs",
    "release:qa": "npm run typecheck && npm test && npm run build && npm run release:static",
    "test:e2e": "node tests/e2e-smoke.cjs",
    "test:mobile": "node tests/mobile-smoke.cjs",
    "test:puzzles": "node tests/puzzle-smoke.cjs",
    "build:mobile": "node scripts/copy-mobile-engine.mjs && vite build --config vite.mobile.config.ts",
    "dev:mobile": "node scripts/copy-mobile-engine.mjs && vite --config vite.mobile.config.ts",
    "android:sync": "npm run build:mobile && cap sync android",
    "android:licenses:prepare": "node scripts/prepare-android-licenses.mjs",
    "android:release:prepare": "npm run build:mobile && npm run android:licenses:prepare && npm run android:sync",
    "android:source:fetch": "node scripts/fetch-stockfish-source.mjs",
    "android:aab:verify": "python scripts/verify-android-aab.py",
    "android:source:verify": "node scripts/verify-stockfish-rebuild.mjs",
    "android:source:test": "py -3 scripts/test-stockfish-source-archive.py",
    "android:source:tools": "node scripts/stockfish-windows-tools.mjs",
    "android:source:review": "python scripts/review-stockfish-source.py",
    "android:complete-source:prepare": "python scripts/prepare-complete-source.py",
    "android:complete-source:verify": "python scripts/verify-complete-source.py",
    "android:complete-source:rebuild": "python scripts/verify-clean-source-build.py",
    "android:source:delivery:verify": "node scripts/verify-source-delivery.mjs compliance/source-delivery-plan.local.json",
    "android:complete-source:rebuild:review": "python scripts/review-clean-source-build.py",
    "android:complete-source:preflight:test": "python scripts/test-clean-source-preflight.py -v"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/share": "^7.0.4",
    "chess.js": "1.4.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "stockfish": "^19.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "9.2.4",
    "electron": "43.2.0",
    "playwright": "^1.64.1",
    "typescript": "^5.9.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
